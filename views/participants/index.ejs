<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - MLMVER2</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>
  
  <div class="container">
    <%- include('../partials/sidebar') %>
    
    <main class="main-content">
      <div class="page-header">
        <h1><%= title %></h1>
      </div>
      
      <div class="filter-bar">
        <form action="/participants" method="GET" class="filter-form">
          <select name="status" class="form-control">
            <option value="">All Status</option>
            <option value="pending" <%= filter.status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="active" <%= filter.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="rejected" <%= filter.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
            <option value="suspended" <%= filter.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
          </select>
          <input type="text" name="search" placeholder="Search..." class="form-control" value="<%= filter.search || '' %>">
          <button type="submit" class="btn btn-secondary">Filter</button>
        </form>
      </div>
      
      <table class="data-table">
        <thead>
          <tr>
            <th>Username</th>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
            <th>Role</th>
            <th>Joined</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% participants.forEach(participant => { %>
            <tr>
              <td><%= participant.username %></td>
              <td><%= participant.profile.firstName %> <%= participant.profile.lastName %></td>
              <td><%= participant.email %></td>
              <td><span class="badge badge-<%= participant.status %>"><%= participant.status %></span></td>
              <td><%= participant.role %></td>
              <td><%= moment(participant.createdAt).format('MMM D, YYYY') %></td>
              <td>
                <a href="/participants/<%= participant._id %>" class="btn btn-sm btn-info">View</a>
                <% if ((user.role === 'admin' || user.role === 'manager') && participant.status === 'pending') { %>
                  <button onclick="approveParticipant('<%= participant._id %>')" class="btn btn-sm btn-success">Approve</button>
                  <button onclick="rejectParticipant('<%= participant._id %>')" class="btn btn-sm btn-danger">Reject</button>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      
      <% if (participants.length === 0) { %>
        <p class="no-results">No participants found.</p>
      <% } %>
    </main>
  </div>
  
  <script src="/js/main.js"></script>
  <script>
    function approveParticipant(id) {
      if (confirm('Approve this participant?')) {
        fetch(`/participants/${id}/approve`, { method: 'POST' })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              location.reload();
            } else {
              alert(data.message);
            }
          });
      }
    }
    
    function rejectParticipant(id) {
      if (confirm('Reject this participant?')) {
        fetch(`/participants/${id}/reject`, { method: 'POST' })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              location.reload();
            } else {
              alert(data.message);
            }
          });
      }
    }
  </script>
</body>
</html>
