<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - MLMVER2</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>
  
  <div class="container">
    <%- include('../partials/sidebar') %>
    
    <main class="main-content">
      <h1><%= title %></h1>
      
      <div class="genealogy-info">
        <div class="user-info-card">
          <h2>Your Position</h2>
          <p><strong>Level:</strong> <%= user.genealogy.level %></p>
          <% if (user.genealogy.upline) { %>
            <p><strong>Upline:</strong> <%= user.genealogy.upline.username %></p>
          <% } else { %>
            <p><strong>Upline:</strong> None (Root)</p>
          <% } %>
          <p><strong>Total Downline:</strong> <%= teamCount %></p>
        </div>
      </div>
      
      <div class="direct-recruits">
        <h2>Direct Downline</h2>
        <% if (downline.length > 0) { %>
          <div class="recruits-grid">
            <% downline.forEach(member => { %>
              <div class="recruit-card">
                <h3><a href="/participants/<%= member._id %>"><%= member.username %></a></h3>
                <p><%= member.profile.firstName %> <%= member.profile.lastName %></p>
                <p>Level: <%= member.genealogy.level %></p>
                <p>Points: <%= member.stats.points %></p>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="no-results">No direct downline yet.</p>
        <% } %>
      </div>
      
      <div class="tree-visualization">
        <h2>Team Tree</h2>
        <div id="tree-container" style="min-height: 400px; border: 1px solid #ddd; border-radius: 8px; padding: 2rem; background: white;">
          <p style="text-align: center; color: #999;">Tree visualization would be displayed here using a library like D3.js or similar</p>
        </div>
      </div>
    </main>
  </div>
  
  <script src="/js/main.js"></script>
  
  <style>
    .genealogy-info {
      margin-bottom: 2rem;
    }
    
    .user-info-card {
      background: white;
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 1.5rem;
    }
    
    .user-info-card h2 {
      margin-bottom: 1rem;
    }
    
    .user-info-card p {
      margin-bottom: 0.5rem;
    }
    
    .direct-recruits {
      margin-bottom: 2rem;
    }
    
    .recruits-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }
    
    .recruit-card {
      background: white;
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 1rem;
    }
    
    .recruit-card h3 {
      margin-bottom: 0.5rem;
    }
    
    .recruit-card h3 a {
      color: #3498db;
      text-decoration: none;
    }
    
    .recruit-card p {
      margin-bottom: 0.25rem;
      font-size: 0.9rem;
    }
    
    .tree-visualization {
      margin-top: 2rem;
    }
  </style>
</body>
</html>
