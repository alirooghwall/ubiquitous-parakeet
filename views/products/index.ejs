<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - MLMVER2</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>
  
  <div class="container">
    <%- include('../partials/sidebar') %>
    
    <main class="main-content">
      <div class="page-header">
        <h1><%= title %></h1>
        <div class="header-actions">
          <% if (user.role === 'admin' || user.role === 'manager') { %>
            <a href="/products/add" class="btn btn-primary">Add Product</a>
          <% } %>
        </div>
      </div>
      
      <div class="filter-bar">
        <form action="/products" method="GET" class="filter-form">
          <select name="category" class="form-control">
            <option value="">All Categories</option>
            <option value="product" <%= filter.category === 'product' ? 'selected' : '' %>>Products</option>
            <option value="package" <%= filter.category === 'package' ? 'selected' : '' %>>Packages</option>
          </select>
          <input type="text" name="search" placeholder="Search..." class="form-control" value="<%= filter.search || '' %>">
          <button type="submit" class="btn btn-secondary">Filter</button>
        </form>
      </div>
      
      <div class="products-grid">
        <% products.forEach(product => { %>
          <div class="product-card">
            <% if (product.image) { %>
              <img src="<%= product.image %>" alt="<%= product.name %>">
            <% } else { %>
              <div class="product-placeholder"><i class="fas fa-box"></i></div>
            <% } %>
            <h3><%= product.name %></h3>
            <p class="product-price">$<%= product.price %></p>
            <p class="product-points"><%= product.points %> points</p>
            <p class="product-stock">Stock: <%= product.stock %></p>
            <a href="/products/<%= product._id %>" class="btn btn-primary btn-sm">View Details</a>
          </div>
        <% }) %>
      </div>
      
      <% if (products.length === 0) { %>
        <p class="no-results">No products found.</p>
      <% } %>
    </main>
  </div>
  
  <script src="/js/main.js"></script>
</body>
</html>
